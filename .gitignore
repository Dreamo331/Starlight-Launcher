# ============================================================
#  Starlight Launcher .gitignore
# ============================================================

# ── 本地专用：真实密钥/端点覆盖文件（绝不要提交）──────────────
# 仓库里的 src/main/resources/assets/endpoints.json 只放占位符；
# 真实密钥写在下面这个文件里，Endpoints 会按 key 覆盖前者。
src/main/resources/assets/endpoints.local.json

# ── 构建产物 ────────────────────────────────────────────────
/target/
/build/
*.class

# ── IDE ────────────────────────────────────────────────────
/.idea/
/.vscode/
*.iml
*.iws

# ── 本地游戏目录与运行数据（非工程文件）──────────────────────
/.minecraft/
/logs/
/Starlight-Launcher/
crash-report-*/

# ── 日志与临时文件 ──────────────────────────────────────────
*.log
*.tmp
/temp/
/references/

# ── 反编译 / 解包 / 旧快照产物（本项目不再纳入版本库）────────
# 这些目录是调试与对照时的临时产物，需要时可从上游重新获取。
/moe/
/srg/
/backup/

# ── 根目录打包产物（体积数百 MB，不入库）────────────────────
/starlight-launcher.zip
/*.zip

# ── 本地调试用的 Mojang 公钥与发现配置（非工程必需）──────────
/mojang_publickey.der
/discovery_minecraftservices_com_minecraft_client.json

# ── 法律文档存证：压缩包不入库，哈希清单 / 时间戳令牌 / 台账必须入库 ──
# BUNDLE-*.zip 可由 witness.ps1 随时重建，且体积较大；证明力来自清单、.tsr 与台账。
/tools/legal-witness/BUNDLE-*.zip
