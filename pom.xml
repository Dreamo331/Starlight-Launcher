<?xml version="1.0" encoding="UTF-8"?>
<!-- (C) Copyright 2026 Starlight. All rights reserved. -->

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.starlight</groupId>
    <artifactId>starlight-launcher-cli</artifactId>
    <!--
      启动器版本：只写纯数字。Maven 与 jpackage 都不接受 -RELEASE 这类后缀，
      jpackage 的 app-version 参数在 Windows 上必须是 major[.minor[.patch]]。
      对外展示与更新比对用的完整版本号（带发布阶段后缀）在
      src/main/java/com/example/starlight/newui/AppConfig.java 的 APP_VERSION，
      两者要保持同一个数字段：这里 1.0.0 对应那边 1.0.0-RELEASE。
      完整规则见 README 的「版本号规则」一节。
    -->
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Starlight Launcher</name>
    <description>Starlight Launcher - Cross-platform Minecraft Launcher (JavaFX)</description>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <gson.version>2.10.1</gson.version>
        <jackson.version>2.17.2</jackson.version>
        <zxing.version>3.5.3</zxing.version>
        <!-- 修正：Kotlin 1.9.24 为已确认存在的稳定老版本 -->
        <kotlin.version>1.9.24</kotlin.version>
    </properties>

    <dependencies>
        <!-- Gson: JSON parser required by StarlightLauncher core lib -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- SLF4J + Logback for structured logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.16</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.16</version>
        </dependency>

        <!-- ice4j: ICE protocol implementation for NAT traversal -->
        <dependency>
            <groupId>org.jitsi</groupId>
            <artifactId>ice4j</artifactId>
            <version>3.2-10-gfcadc70</version>
        </dependency>

        <!-- Jackson: generate .bat launch scripts -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- ZXing: generate QR codes for error log links -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>${zxing.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>${zxing.version}</version>
        </dependency>

        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>17.0.6</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>17.0.6</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>17.0.6</version>
        </dependency>

        <!-- StarlightLauncher core library (local JAR in lib/) -->
        <!-- 注意：这里的 2.0.0 是「核心库」自己的 artifact 版本，跟启动器版本（1.0.0）是两回事，
             不要为了统一版本号把它改掉——改了就得同步重命名 lib/StarlightLauncher-2.0.0.jar 并重新 install-file。
             使用前请先安装到本地仓库：
             mvn install:install-file -Dfile=lib/StarlightLauncher-2.0.0.jar -DgroupId=com.starlight -DartifactId=starlight-launcher-core -Dversion=2.0.0 -Dpackaging=jar -->
        <dependency>
            <groupId>com.starlight</groupId>
            <artifactId>starlight-launcher-core</artifactId>
            <version>2.0.0</version>
        </dependency>

        <!-- Kotlin -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib-jdk8</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-reflect</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test</artifactId>
            <version>${kotlin.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JavaMail: send feedback emails via 139 SMTP -->
        <dependency>
            <groupId>com.sun.mail</groupId>
            <artifactId>javax.mail</artifactId>
            <version>1.6.2</version>
        </dependency>

        <!-- Apache Commons Compress: tar.gz extraction (Terracotta) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.26.2</version>
        </dependency>

        <!-- JetBrains Annotations -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>24.1.0</version>
            <scope>compile</scope>
        </dependency>

        <!-- OSHI: 系统硬件信息（磁盘读写速率统计，与任务管理器性能页一致） -->
        <dependency>
            <groupId>com.github.oshi</groupId>
            <artifactId>oshi-core</artifactId>
            <version>6.6.3</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*.fxml</include>
                    <include>**/*.css</include>
                    <include>**/*.png</include>
                    <include>**/*.properties</include>
                    <include>**/*.xml</include>
                    <include>**/*.html</include>
                    <include>**/*.json</include>
                    <!-- Mod 中文名字典（assets/mod_data.txt、assets/modpack_data.txt）等纯文本资源 -->
                    <include>**/*.txt</include>
                    <!-- 品牌 logo（svg/GitHub_light.svg、svg/gitee_logo_black.svg）：AppIcons 运行期读取 -->
                    <include>**/*.svg</include>
                    <!-- UI 字体（ttf/JustFontFenYuanZiTi-2.ttf）：AppFonts 启动时用 Font.loadFont 注册。
                         漏掉这行字体不会进 target/classes，界面会静默回退系统字体。 -->
                    <include>**/*.ttf</include>
                    <include>**/*.otf</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <!-- JavaFX Maven Plugin -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.example.starlight.MainApp</mainClass>
                </configuration>
            </plugin>

            <!-- Package executable fat JAR (used for agent-based config collection) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <descriptors>
                        <descriptor>${project.basedir}/src/main/assembly/fatjar.xml</descriptor>
                    </descriptors>
                    <archive>
                        <manifest>
                            <mainClass>com.example.starlight.MainApp</mainClass>
                        </manifest>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Run plugin: execute project directly -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.example.starlight.MainApp</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Kotlin compiler -->
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <sourceDirs>
                                <sourceDir>src/main/kotlin</sourceDir>
                                <sourceDir>target/generated-sources/annotations</sourceDir>
                            </sourceDirs>
                        </configuration>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                        <configuration>
                            <sourceDirs>
                                <sourceDir>src/test/java</sourceDir>
                                <sourceDir>target/generated-test-sources/test-annotations</sourceDir>
                            </sourceDirs>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <jvmTarget>${maven.compiler.target}</jvmTarget>
                </configuration>
            </plugin>

            <!-- Maven Compiler Plugin (disabled default executions because Kotlin handles compilation) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Build time: copy JavaFX module JARs to target/modules/ for module path loading -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-javafx-modules</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.openjfx</groupId>
                                    <artifactId>javafx-controls</artifactId>
                                    <classifier>win</classifier>
                                    <version>17.0.6</version>
                                    <outputDirectory>${project.build.directory}/modules</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.openjfx</groupId>
                                    <artifactId>javafx-fxml</artifactId>
                                    <classifier>win</classifier>
                                    <version>17.0.6</version>
                                    <outputDirectory>${project.build.directory}/modules</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.openjfx</groupId>
                                    <artifactId>javafx-graphics</artifactId>
                                    <classifier>win</classifier>
                                    <version>17.0.6</version>
                                    <outputDirectory>${project.build.directory}/modules</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.openjfx</groupId>
                                    <artifactId>javafx-base</artifactId>
                                    <classifier>win</classifier>
                                    <version>17.0.6</version>
                                    <outputDirectory>${project.build.directory}/modules</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.openjfx</groupId>
                                    <artifactId>javafx-web</artifactId>
                                    <classifier>win</classifier>
                                    <version>17.0.6</version>
                                    <outputDirectory>${project.build.directory}/modules</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.openjfx</groupId>
                                    <artifactId>javafx-media</artifactId>
                                    <classifier>win</classifier>
                                    <version>17.0.6</version>
                                    <outputDirectory>${project.build.directory}/modules</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteSnapshots>false</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- GluonFX Native Image plugin (GraalVM) - generates single unextractable EXE -->
            <plugin>
                <groupId>com.gluonhq</groupId>
                <artifactId>gluonfx-maven-plugin</artifactId>
                <version>1.0.29</version>
                <configuration>
                    <mainClass>com.example.starlight.MainApp</mainClass>
                    <verbose>true</verbose>
                    <!-- 与项目 JavaFX 17 主版本匹配的 Gluon 静态 SDK（用于 native-image 静态链接） -->
                    <javafxStaticSdkVersion>17.0.8</javafxStaticSdkVersion>
                    <!-- 将所有运行期资源（FXML/CSS/图片/SVG/配置）打入原生镜像 -->
                    <!-- 注意: gluonfx 序列化 resourcesList 时不做 JSON 转义, 原样写入 resourceconfig JSON.
                         因此这里必须写 JSON 合法转义形式 \\. (生成的 JSON 里即 \\., 解析后正则为 \.);
                         写单反斜杠 \. 会让 resourceconfig-x86_64-windows.json 成为非法 JSON,
                         native-image 报 "Invalid escape character". step3-fix.ps1 里还有兜底修复. -->
                    <resourcesList>
                        <list>.*\\.(fxml|css|png|jpg|jpeg|ico|svg|properties|json|xml|html|txt|ttf|otf|dll|dat|so|dylib)$</list>
                    </resourcesList>
                    <!-- Gson 反射模型类：Native Image 关闭运行期反射，必须显式注册
                         （LaunchRecord 最近游玩 / Community* 社区登录 / Modrinth* 模组库 / CacheEntry） -->
                    <reflectionList>
                        <list>com.example.starlight.launch.LaunchRecord</list>
                        <list>com.example.starlight.community.CommunityApi$CommunityUser</list>
                        <list>com.example.starlight.community.CommunityApi$CommunityPost</list>
                        <list>com.example.starlight.community.CommunityApi$CommunityComment</list>
                        <list>com.example.starlight.ModsApi.ModrinthAPI$ModrinthProject</list>
                        <list>com.example.starlight.ModsApi.ModrinthAPI$GameVersion</list>
                        <list>com.example.starlight.ModsApi.ModrinthAPI$ModrinthVersion</list>
                        <list>com.example.starlight.ModsApi.ModrinthAPI$ModrinthFile</list>
                        <list>com.example.starlight.version.CacheManager$CacheEntry</list>
                        <!-- FXML fx:controller 控制器：FXMLLoader 反射实例化 + @FXML 字段注入 + initialize() 回调 -->
                        <list>com.example.starlight.newui.StarlightSplashController</list>
                        <!-- FXML 中实例化的 JavaFX 类：FXMLLoader 需要无参构造器反射元数据
                             （substrate 自带的 JavaFX 反射配置只有方法，缺构造器，native 下会报
                             NoSuchMethodException: Canvas.<init>()） -->
                        <list>javafx.scene.canvas.Canvas</list>
                        <list>javafx.scene.layout.Region</list>
                        <list>javafx.scene.layout.StackPane</list>
                        <list>javafx.scene.layout.VBox</list>
                        <list>javafx.scene.layout.HBox</list>
                        <list>javafx.scene.text.Text</list>
                        <list>javafx.scene.shape.Rectangle</list>
                        <list>javafx.geometry.Insets</list>
                        <list>javafx.scene.layout.Pane</list>
                        <list>javafx.scene.layout.AnchorPane</list>
                        <list>javafx.scene.layout.BorderPane</list>
                        <list>javafx.scene.layout.GridPane</list>
                        <list>javafx.scene.control.Label</list>
                        <list>javafx.scene.control.Button</list>
                        <list>javafx.scene.image.ImageView</list>
                        <list>javafx.scene.control.ProgressBar</list>
                        <list>javafx.scene.control.TextField</list>
                        <list>javafx.scene.control.PasswordField</list>
                        <list>javafx.scene.control.ListView</list>
                        <list>javafx.scene.control.ScrollPane</list>
                        <list>javafx.scene.control.Separator</list>
                        <list>javafx.scene.control.CheckBox</list>
                        <list>javafx.scene.control.RadioButton</list>
                        <list>javafx.scene.control.ComboBox</list>
                        <list>javafx.scene.control.TextArea</list>
                        <list>javafx.scene.control.Hyperlink</list>
                        <list>javafx.scene.control.Tab</list>
                        <list>javafx.scene.control.TabPane</list>
                        <list>javafx.scene.control.ToggleGroup</list>
                        <list>javafx.scene.layout.ColumnConstraints</list>
                        <list>javafx.scene.layout.RowConstraints</list>
                        <list>javafx.scene.Group</list>
                        <list>javafx.scene.web.WebView</list>
                        <!-- Prism 特效原生 peer 类：Bloom/Blur/BlendMode 等特效渲染时反射
                             加载 com.sun.scenario.effect.impl.prism.ps.PPS*Peer，缺注册会报
                             "Could not create peer Brightpass" 且整帧画不出来（闪屏黑屏/透明） -->
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_ADDPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_BLUEPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_COLOR_BURNPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_COLOR_DODGEPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_DARKENPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_DIFFERENCEPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_EXCLUSIONPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_GREENPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_HARD_LIGHTPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_LIGHTENPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_MULTIPLYPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_OVERLAYPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_REDPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_SCREENPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_SOFT_LIGHTPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_SRC_ATOPPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_SRC_INPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_SRC_OUTPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSBlend_SRC_OVERPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSBrightpassPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSColorAdjustPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSDisplacementMapPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSEffectPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSInvertMaskPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSLinearConvolvePeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSLinearConvolveShadowPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSOneSamplerPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSPerspectiveTransformPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSPhongLighting_DISTANTPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSPhongLighting_POINTPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSPhongLighting_SPOTPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSSepiaTonePeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPStoPSWDisplacementMapPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSTwoSamplerPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.ps.PPSZeroSamplerPeer</list>
                        <!-- Prism 主包 peers: Crop/Flood/Merge/Reflection 等特效的 peer 不在 ps 子包 -->
                        <list>com.sun.scenario.effect.impl.prism.PrCropPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.PrFloodPeer</list>
                        <list>com.sun.scenario.effect.impl.prism.PrMergePeer</list>
                        <list>com.sun.scenario.effect.impl.prism.PrReflectionPeer</list>
                        <!-- 软件渲染回退管线 peers (JSW=纯Java, SSE=SSE指令集):
                             GPU/D3D 初始化失败的机器会整体切到这两套管线, 分发给玩家的 EXE 必须兜底 -->
                        <list>com.sun.scenario.effect.impl.sw.java.JSWBlend_ADDPeer</list>
                        <list>com.sun.scenario.effect.impl.sw.java.JSWBlend_BLUEPeer</list>
                        <list>com.sun.scenario.effect.impl.sw.java.JSWBlend_COLOR_BURNPeer</list>
                        <list>com.sun.scenario.effect.impl.sw.java.JSWBlend_COLOR_DODGEPeer</list>
                        <list>com.sun.scenario.effect.impl.sw.java.JSWBlend_DARKENPeer</list>
                        <list>com.sun.scenario.effect.impl.sw.java.JSWBlend_DIFFERENCEPeer</list>
                        <list>com.sun.scenario.effect.impl.sw.java.JSWBlend_EXCLUSIONPeer</list>
                        <list>com.sun.scenario.effect.impl.sw.java.JSWBlend_GREENPeer</list>
                        <list>com.sun.scenario.effect.impl.sw.java.JSWBlend_HARD_LIGHTPeer</list>
                        <list>com.sun.scenario.effect.impl.sw.java.JSWBlend_LIGHTENPeer</list>
                        <list>com.sun.scenario.effect.impl.sw.java.JSWBlend_MULTIPLYPeer</list>
                        <list>com.sun.scenario.effect.impl.sw.java.JSWBlend_OVERLAYPeer</list>
                        <list>com.sun.scenario.effect.impl.sw.java.JSWBlend_REDPeer</list>
                        <list>com.sun.scenario.effect.impl.sw.java.JSWBlend_SCREENPeer</list>
                        <list>com.sun.scenario.effect.impl.sw.java.JSWBlend_SOFT_LIGHTPeer</list>
                        <list>com.sun.scenario.effect.impl.sw.java.JSWBlend_SRC_ATOPPeer</list>
                        <list>com.sun.scenario.effect.impl.sw.java.JSWBlend_SRC_INPeer</list>
                        <list>com.sun.scenario.effect.impl.sw.java.JSWBlend_SRC_OUTPeer</list>
                        <list>com.sun.scenario.effect.impl.sw.java.JSWBlend_SRC_OVERPeer</list>
                        <list>com.sun.scenario.effect.impl.sw.java.JSWBoxBlurPeer</list>
