    <!-- Native packaging profile: jlink + jpackage (kept for alternative use) -->
    <profiles>
        <profile>
            <id>native-package</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <!-- jlink: create trimmed JRE runtime -->
                            <execution>
                                <id>jlink-create-runtime</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>jlink</executable>
                                    <commandlineArgs>--module-path "${java.home}/jmods;${project.build.directory}/modules" --add-modules java.base,java.logging,java.xml,java.desktop,java.management,java.naming,java.net.http,java.prefs,java.scripting,java.sql,jdk.management,jdk.unsupported,jdk.crypto.ec,jdk.crypto.mscapi,jdk.localedata,jdk.charsets,javafx.controls,javafx.fxml,javafx.web --output "${project.build.directory}/runtime" --strip-debug --no-header-files --no-man-pages --compress=2</commandlineArgs>
                                </configuration>
                            </execution>
                            <!-- jpackage: portable app-image directory (no installer, no temp extraction) -->
                            <execution>
                                <id>jpackage-create-app-image</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <commandlineArgs>--name StarlightLauncher --app-version ${project.version} --type app-image --input "${project.build.directory}" --main-jar ${project.build.finalName}-jar-with-dependencies.jar --main-class com.example.starlight.MainApp --runtime-image "${project.build.directory}/runtime" --dest "${project.basedir}/build/StarlightLauncherApp"</commandlineArgs>
                                </configuration>
                            </execution>
                            <!-- jpackage: installer EXE (not the single-file native approach) -->
                            <execution>
                                <id>jpackage-create-image</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <commandlineArgs>--name StarlightLauncher --app-version ${project.version} --type exe --input "${project.build.directory}" --main-jar ${project.build.finalName}-jar-with-dependencies.jar --main-class com.example.starlight.MainApp --runtime-image "${project.build.directory}/runtime" --dest "${project.basedir}/build/StarlightLauncher" --win-dir-chooser --win-menu</commandlineArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>